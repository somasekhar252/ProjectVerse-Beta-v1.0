rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Projects collection rules
    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null && (resource.data.ownerId == request.auth.uid || request.auth.uid != null);
    }

    // Reels collection rules
    match /reels/{reelId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Users collection rules
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Direct Messages collection rules
    match /dms/{dmId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Global fallback for prototyping & student showcases
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
